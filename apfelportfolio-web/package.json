{
  "name": "apfelportfolio-web",
  "version": "0.1.0",
  "description": "Lernspiel Apfelportfolio - Portfoliomanagement fuer Azubis (Single-File-HTML)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
