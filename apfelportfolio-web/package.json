    "pruefen:referenz": "node tools/referenz_pruefen.mjs"
  },
  "dependencies": {
    "marked": "18.1.3",
    "preact": "11.1.1",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.1"
  }
}
